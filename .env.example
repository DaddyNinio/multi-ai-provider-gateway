# ---------------------------------------------------------------------------
# unified-ai-gateway configuration
# Copy to .env and adjust. All values shown are the defaults.
#
# This gateway talks DIRECTLY to GitHub Copilot and the Kiro/Amazon Q runtime.
# There are no upstream servers to run. Authentication is read from the local
# credentials the official tools already create (see below).
# ---------------------------------------------------------------------------

# Port this gateway listens on.
PORT=9000

# Prefix applied to Copilot model ids in /v1/models so they never collide with
# Kiro model ids. Request "copilot/<id>" to force the Copilot backend.
COPILOT_PREFIX=copilot/

# Prefix applied to Kiro model ids in /v1/models so you can tell them apart from
# Copilot models in a client's model picker. Request "kiro/<id>" to force Kiro.
KIRO_PREFIX=kiro/

# Per-request timeout in milliseconds.
REQUEST_TIMEOUT_MS=600000

# ---------------------------------------------------------------------------
# Credentials (read automatically; override only if needed)
# ---------------------------------------------------------------------------
# GitHub Copilot: a GitHub OAuth token is read from
#   ~/.local/share/copilot-api/github_token
# You can instead set it explicitly here:
# GITHUB_TOKEN=

# Kiro/Amazon Q: the access token + profile ARN are read from the kiro-cli
# SQLite database created by `kiro login`:
#   ~/Library/Application Support/kiro-cli/data.sqlite3
# (Requires the `sqlite3` CLI to be installed — it ships with macOS.)
