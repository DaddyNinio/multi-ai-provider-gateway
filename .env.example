# ---------------------------------------------------------------------------
# unified-ai-gateway configuration
# Copy to .env and adjust. All values shown are the defaults.
# ---------------------------------------------------------------------------

# Port this gateway listens on.
PORT=9000

# --- Upstream: kiro-gateway (jwadow/kiro-gateway) ---
KIRO_GATEWAY_URL=http://localhost:8000
KIRO_GATEWAY_KEY=

# --- Upstream: copilot-api (caozhiyuan/copilot-api) ---
COPILOT_API_URL=http://localhost:4141
COPILOT_API_KEY=

# Prefix applied to copilot-api model ids in /v1/models so they never collide
# with kiro model ids. Requests for "copilot/<id>" are routed to copilot-api
# with the prefix stripped.
COPILOT_PREFIX=copilot/

# Per-request upstream timeout in milliseconds.
REQUEST_TIMEOUT_MS=600000
