{
  "name": "multi-ai-provider-gateway",
  "version": "1.0.0",
  "description": "A single Anthropic/OpenAI-compatible gateway that merges the model catalogs of kiro-gateway and copilot-api behind one endpoint.",
  "keywords": [
    "ai-gateway",
    "anthropic-compatible",
    "openai-compatible",
    "kiro",
    "github-copilot",
    "claude-code"
  ],
  "license": "MIT",
  "type": "module",
  "bin": {
    "multi-ai-provider-gateway": "./dist/main.js"
  },
  "files": [
    "dist",
    ".env.example",
    "README.md"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "setup-claude": "tsx src/main.ts --setup-claude",
    "build": "tsc && chmod +x dist/main.js",
    "serve": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
